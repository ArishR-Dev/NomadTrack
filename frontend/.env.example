# API base URL for the backend. No trailing slash.
#
# Local development (frontend and backend on your machine):
#   VITE_API_BASE_URL=http://localhost:5000
#
# Lovable cloud preview or production (backend must be publicly reachable):
#   Deploy backend to Render, Railway, etc., then set e.g.:
#   VITE_API_BASE_URL=https://your-app.onrender.com
#
VITE_API_BASE_URL=http://localhost:5000
