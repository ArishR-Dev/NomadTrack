# Copy to .env and fill in your values
# cp .env.example .env

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nomadtrack
JWT_SECRET=your_super_secret_key_change_this
PORT=5000
# Frontend origin for CORS (comma-separated for multiple). Vite in this project runs on 5173 by default.
FRONTEND_URL=http://localhost:5173

# Backend URL used for Google OAuth redirect_uri (must match URL you use to reach this server).
BACKEND_URL=http://localhost:5000

# Google OAuth (optional). Get from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web), add redirect URI: http://localhost:5000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
